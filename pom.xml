<!-- Denizen build file -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.denizenscript</groupId>
    <artifactId>denizen-parent</artifactId>
    <packaging>pom</packaging>
    <version>1.3.1-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <BUILD_NUMBER>Unknown</BUILD_NUMBER>
        <BUILD_CLASS>CUSTOM</BUILD_CLASS>
        <DENIZEN_VERSION>1.3.1</DENIZEN_VERSION>
    </properties>

    <!-- Folia fork (target: Folia 1.21.11). Legacy version modules (v1_17..v1_20) and the separate `paper` module
         are pruned to shrink fork-maintenance surface; only the 1.21.x NMS module is kept. Paper-specific features
         fall back gracefully (PaperModule is loaded reflectively with a ClassNotFound fallback). -->
    <modules>
        <module>plugin</module>
        <module>v1_21</module>
        <module>dist</module>
    </modules>

    <!-- Repositories -->
    <repositories>
        <repository>
            <id>everything</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
        <!-- PaperMC: paper-api carries the Folia regionized scheduler API (GlobalRegionScheduler, RegionScheduler,
             AsyncScheduler, Entity#getScheduler, Bukkit.isGlobalTickThread). Folia ships these same APIs. -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <ciManagement>
        <system>jenkins</system>
        <url>https://ci.citizensnpcs.co</url>
    </ciManagement>
    <scm>
        <connection>scm:git:git://github.com/DenizenScript/Denizen.git</connection>
        <developerConnection>scm:git:git:@github.com:DenizenScript/Denizen.git</developerConnection>
        <url>https://github.com/DenizenScript/Denizen/tree/dev/</url>
    </scm>
    <distributionManagement>
        <repository>
            <id>citizens-repo</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
    </distributionManagement>

    <build>
        <defaultGoal>clean package install</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>default-deploy</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <url>https://denizenscript.com/</url>
</project>
